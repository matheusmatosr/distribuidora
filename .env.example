# URL e chaves do seu projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usada apenas pela Edge Function de alerta de estoque (NUNCA exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave da API do Resend, usada pela Edge Function de alerta de estoque
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email remetente configurado/verificado no Resend
ALERT_FROM_EMAIL=alertas@seudominio.com
